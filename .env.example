# ----- Prem Bahis ortam degiskenleri (Vercel + Supabase) -----

# Supabase veritabani baglantisi (Connection Pooling / Transaction, port 6543)
# Supabase panel -> Project Settings -> Database -> Connection string -> "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:SIFRE@aws-0-...pooler.supabase.com:6543/postgres

# Oturum/cerez imzalama anahtari. Rastgele uzun bir metin gir.
SESSION_SECRET=degistir-bunu-uzun-rastgele-bir-metinle

# Ilk admin hesabinin bilgileri (ilk calismada olusturulur)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Her yeni onaylanan kullaniciya verilecek baslangic bakiyesi (ASCU)
START_BALANCE=1000

# --- OYUN KURALLARI ---
# KURAL 1: Her maca en az bu kadar ASCU ile kupon yapilabilir.
MIN_STAKE=50
# KURAL 2: Turnuva bu tarihte biter; bu andan sonra yeni kupon yapilamaz (Turkiye saati).
TOURNAMENT_END=2027-01-01T00:00:00+03:00
# KURAL 3: Kupon oynanmayan ve oynamaya kapanmis her mac icin dusulen ceza (ASCU).
NO_BET_PENALTY=100

# --- CANLI VERI (The Odds API) ---
# https://the-odds-api.com adresinden ucretsiz uye ol, API anahtarini buraya yapistir.
# Bos birakirsan uygulama ornek maclarla calisir.
ODDS_API_KEY=
ODDS_REGION=eu

# --- ILK YARI skorlari icin (istege bagli, ucretsiz) ---
# https://www.football-data.org uye ol -> token al. Girersen "Sonuclari Cek"
# ilk yari skorunu da otomatik ceker ve ilk yari kuponlarini hesaplar (elle giris gerekmez).
# Bos birakirsan ilk yari kuponlari sonuclanamaz ve otomatik iade edilir.
FOOTBALL_DATA_TOKEN=

# --- SAHA RAPORU (UCRETSIZ AI, tam otomatik) ---
# Google Gemini API anahtari (aistudio.google.com -> Get API key). UCRETSIZ kota.
# Girildiyse site yaklasan maclara otomatik Saha Raporu uretir (yazili analiz + xG
# icin Google Search grounding). Bos ise AI uretimi kapali; elle yapistirma calisir.
GEMINI_API_KEY=
# Kullanilacak Gemini modeli (ucretsiz: gemini-2.0-flash / gemini-2.5-flash).
GEMINI_MODEL=gemini-2.0-flash
# Google Search grounding'i kapatmak istersen 0 yap (varsayilan acik).
AI_WEB_SEARCH=1
# API-Football anahtari (dashboard.api-football.com -> ucretsiz plan, ~100 istek/gun).
# Sakat oyuncu, H2H, hakem, stadyum bilgisini buradan ceker. Bos ise bu alanlar
# yalnizca Gemini aramasiyla doldurulmaya calisilir.
APIFOOTBALL_KEY=
# Kac gun onceden rapor uretilsin (varsayilan 2).
REPORT_DAYS=2

# Saha Raporu'nu disaridan yazmak icin (opsiyonel; token'li REST ucu).
REPORT_TOKEN=

# --- Otomatik gunluk guncelleme (Vercel Cron) icin, istege bagli ---
# Rastgele bir metin gir; Vercel cron cagrilari bu anahtarla dogrulanir.
CRON_SECRET=
